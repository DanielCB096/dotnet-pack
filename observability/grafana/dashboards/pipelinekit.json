      "targets": [
        {
          "refId": "A",
          "expr": "sum(pipeline_rows_extracted_total)",
          "legendFormat": "rows"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
